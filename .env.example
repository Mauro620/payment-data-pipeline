# Copy to .env and fill in local values. Never commit .env.

# Local warehouse (Postgres)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Airflow (Module 3). Metadata DB is created in the same Postgres instance.
AIRFLOW_DB=airflow
AIRFLOW_UID=50000   # Linux: use `id -u`
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# AWS (Module 5)
AWS_REGION=
AWS_S3_BUCKET=
